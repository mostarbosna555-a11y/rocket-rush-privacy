# Sunucu portu
PORT=3000

# Veritabani dosyasi (varsayilan: ./data/klinik.db)
# DB_PATH=/var/lib/klinik/klinik.db

# Ilk calistirmada olusturulan admin kullanicisinin sifresi.
# Bos birakilirsa admin123 kullanilir ve uyari basilir.
ADMIN_PASSWORD=degistir-beni

# HTTPS arkasinda calisiyorsa cerezi Secure isaretle
# COOKIE_SECURE=true

# Organik Haberlesme API (anahtar arayuzden de girilebilir)
# ORGANIK_BASE_URL=https://api.organikhaberlesme.com
# ORGANIK_AUTH_HEADER=X-Organik-API
